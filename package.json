{
  "name": "privacyfill-ai-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-preserving Chrome form-filling agent for the SIH MVP.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run server",
    "demo": "node scripts/serve-demo.mjs",
    "server": "node server/index.js",
    "build:extension": "node scripts/build-extension.mjs",
    "test": "npm run build:extension --silent && node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:privacy": "node --test tests/unit/contracts.test.js tests/unit/leak-checker.test.js tests/integration/privacy-boundary.test.js tests/integration/plan-route.test.js",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "verify": "npm run test && npm run verify:secrets"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
